<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live World Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 text-gray-800">

  <!-- Header Section -->
  <header class="bg-blue-600 text-white py-4 shadow-md">
    <div class="container mx-auto text-center">
      <h1 class="text-3xl font-bold">Live World Data Dashboard</h1>
      <p class="text-lg mt-2">Stay updated with the latest global statistics</p>
    </div>
  </header>

  <!-- Global Summary Section -->
  <section class="container mx-auto mt-6">
    <div id="global-summary" class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold text-gray-600">Total Cases</h2>
        <p id="total-cases" class="text-4xl font-bold text-blue-600">...</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold text-gray-600">Total Deaths</h2>
        <p id="total-deaths" class="text-4xl font-bold text-red-600">...</p>
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold text-gray-600">Total Recovered</h2>
        <p id="total-recovered" class="text-4xl font-bold text-green-600">...</p>
      </div>
    </div>
  </section>

  <!-- Live Table Section -->
  <section class="container mx-auto mt-10">
    <h2 class="text-2xl font-bold text-gray-700 mb-4 text-center">Country-Wise Statistics</h2>
    <div class="overflow-x-auto">
      <table class="table-auto w-full border-collapse border border-gray-300 bg-white rounded-lg shadow-md">
        <thead class="bg-gray-200">
          <tr>
            <th class="border border-gray-300 px-4 py-2">Country</th>
            <th class="border border-gray-300 px-4 py-2">Total Cases</th>
            <th class="border border-gray-300 px-4 py-2">Deaths</th>
            <th class="border border-gray-300 px-4 py-2">Recovered</th>
          </tr>
        </thead>
        <tbody id="data-table">
          <!-- Rows will be dynamically inserted here -->
        </tbody>
      </table>
    </div>
  </section>

  <!-- Charts Section -->
  <section class="container mx-auto mt-10">
    <h2 class="text-2xl font-bold text-gray-700 mb-4 text-center">Visual Analytics</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Pie Chart -->
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h3 class="text-xl font-bold text-gray-600 mb-4">Global Cases Breakdown</h3>
        <canvas id="globalChart"></canvas>
      </div>
      <!-- Bar Chart -->
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h3 class="text-xl font-bold text-gray-600 mb-4">Top 5 Affected Countries</h3>
        <canvas id="barChart"></canvas>
      </div>
    </div>
  </section>

  <!-- JavaScript -->
  <script>
    const globalSummary = {
      totalCases: document.getElementById('total-cases'),
      totalDeaths: document.getElementById('total-deaths'),
      totalRecovered: document.getElementById('total-recovered'),
    };

    const globalChartCtx = document.getElementById('globalChart').getContext('2d');
    const barChartCtx = document.getElementById('barChart').getContext('2d');

    let globalChart;
    let barChart;

    async function fetchLiveData() {
      try {
        const response = await axios.get('https://disease.sh/v3/covid-19/all');
        const countryResponse = await axios.get('https://disease.sh/v3/covid-19/countries');
        
        // Update global summary
        globalSummary.totalCases.textContent = response.data.cases.toLocaleString();
        globalSummary.totalDeaths.textContent = response.data.deaths.toLocaleString();
        globalSummary.totalRecovered.textContent = response.data.recovered.toLocaleString();

        // Update table
        const tableBody = document.getElementById('data-table');
        tableBody.innerHTML = '';
        countryResponse.data.forEach((country) => {
          const row = `
            <tr>
              <td class="border border-gray-300 px-4 py-2">${country.country}</td>
              <td class="border border-gray-300 px-4 py-2">${country.cases.toLocaleString()}</td>
              <td class="border border-gray-300 px-4 py-2">${country.deaths.toLocaleString()}</td>
              <td class="border border-gray-300 px-4 py-2">${country.recovered.toLocaleString()}</td>
            </tr>
          `;
          tableBody.insertAdjacentHTML('beforeend', row);
        });

        // Update charts
        updateCharts(response.data, countryResponse.data);
      } catch (error) {
        console.error('Error fetching data:', error);
      }
    }

    function updateCharts(globalData, countryData) {
      const topCountries = countryData
        .sort((a, b) => b.cases - a.cases)
        .slice(0, 5);

      // Update Global Pie Chart
      const pieData = {
        labels: ['Cases', 'Deaths', 'Recovered'],
        datasets: [{
          data: [globalData.cases, globalData.deaths, globalData.recovered],
          backgroundColor: ['#4299E1', '#F56565', '#48BB78'],
        }],
      };

      if (globalChart) globalChart.destroy();
      globalChart = new Chart(globalChartCtx, {
        type: 'pie',
        data: pieData,
      });

      // Update Top Countries Bar Chart
      const barData = {
        labels: topCountries.map(country => country.country),
        datasets: [{
          label: 'Total Cases',
          data: topCountries.map(country => country.cases),
          backgroundColor: '#4299E1',
        }],
      };

      if (barChart) barChart.destroy();
      barChart = new Chart(barChartCtx, {
        type: 'bar',
        data: barData,
      });
    }

    // Fetch data every 10 seconds
    setInterval(fetchLiveData, 10000);
    fetchLiveData();
  </script>
</body>
</html>
